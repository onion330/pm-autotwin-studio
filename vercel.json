{
  "redirects": [
    {
      "source": "/demo/ev-seat",
      "destination": "/demo/ev-seat/",
      "permanent": false
    },
    {
      "source": "/guide",
      "destination": "/manual/en",
      "permanent": true
    },
    {
      "source": "/PM_AutoTwin_Studio_User_Guide",
      "destination": "/manual/en",
      "permanent": true
    },
    {
      "source": "/PM_AutoTwin_Studio_User_Guide.html",
      "destination": "/manual/en",
      "permanent": true
    },
    {
      "source": "/guide-kr",
      "destination": "/manual/ko",
      "permanent": true
    },
    {
      "source": "/PM_AutoTwin_Studio_사용가이드.html",
      "destination": "/manual/ko",
      "permanent": true
    },
    {
      "source": "/PM_AutoTwin_Studio_%EC%82%AC%EC%9A%A9%EA%B0%80%EC%9D%B4%EB%93%9C.html",
      "destination": "/manual/ko",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/manual",
      "destination": "/manual/index.html"
    },
    {
      "source": "/manual/ko",
      "destination": "/manual/ko.html"
    },
    {
      "source": "/manual/en",
      "destination": "/manual/en.html"
    },
    {
      "source": "/manual/ja",
      "destination": "/manual/ja.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/demo/ev-seat/",
      "destination": "/demo/ev-seat/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/manual(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
