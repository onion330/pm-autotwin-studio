{
  "rewrites": [
    {
      "source": "/manual",
      "destination": "/manual/index.html"
    },
    {
      "source": "/manual/ko",
      "destination": "/manual/ko.html"
    },
    {
      "source": "/manual/en",
      "destination": "/manual/en.html"
    },
    {
      "source": "/manual/ja",
      "destination": "/manual/ja.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/PM_AutoTwin_Studio_User_Guide",
      "destination": "/PM_AutoTwin_Studio_User_Guide.html"
    },
    {
      "source": "/guide",
      "destination": "/PM_AutoTwin_Studio_User_Guide.html"
    },
    {
      "source": "/guide-kr",
      "destination": "/PM_AutoTwin_Studio_사용가이드.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manual(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
